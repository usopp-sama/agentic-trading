# systemd unit for bare-metal supervision on a laptop or Raspberry Pi.
#
# Install:
#   sudo cp deploy/ats.service /etc/systemd/system/ats.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now ats
# Logs:   journalctl -u ats -f
#
# This runs the standalone (SQLite + in-memory bus) mode. For the scaled stack
# use docker-compose instead. Adjust User/paths to your environment.

[Unit]
Description=Agentic Trading Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ats
WorkingDirectory=/opt/ats
EnvironmentFile=/opt/ats/.env
ExecStart=/opt/ats/.venv/bin/uvicorn ats.server.app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
# Crash-loop protection: give up only after sustained failures.
StartLimitIntervalSec=300
StartLimitBurst=10

# Hardening (least privilege).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ats/var
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=2G

[Install]
WantedBy=multi-user.target
