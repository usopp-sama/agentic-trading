# Copy to repo-root .env and fill in. NEVER commit real secrets.
# All keys are optional for v1 (paper, offline). Fill them as you enable features.

# --- Core ---
ATS_ENV=dev
ATS_DEBUG=true

# --- Storage (SQLite default; Postgres/TimescaleDB for production) ---
# ATS_DB_URL=postgresql+psycopg://ats:ats@postgres:5432/ats
ATS_DB_URL=sqlite:///var/ats.db

# --- Event bus (memory default; redis for multi-service) ---
ATS_EVENT_BUS=memory
# ATS_REDIS_URL=redis://redis:6379/0

# --- Market data (yfinance | synthetic | nse_live | kite) ---
# yfinance   = real (delayed) NSE daily data; falls back to synthetic per-symbol
#              only if a live fetch fails.
# nse_live   = yfinance daily + free intraday candles/quotes (no API key). Best
#              for the month-long paper run; the Kite adapter drops in later.
# synthetic  = fully offline (no network).
ATS_DATA_SOURCE=nse_live
# Pause live polling outside NSE hours (synthetic is exempt). Keep true.
ATS_RESPECT_MARKET_HOURS=true

# --- Trading mode + real-money gate ---
# mode: OFF | PAPER | APPROVAL | AUTO. Keep PAPER for the month-long paper run.
ATS_TRADING_MODE=PAPER
# Master safety gate. Leave false until paper/shadow + compliance pass.
ATS_REAL_MONEY_ENABLED=false
ATS_PAPER_STARTING_CAPITAL=1000000

# --- LAN access (dashboard) ---
# 127.0.0.1 = this machine only. 0.0.0.0 = reachable from other LAN devices.
# When ATS_DASHBOARD_TOKEN is set, the dashboard requires ?token=... once.
# ATS_HOST=0.0.0.0
# ATS_PORT=8000
# ATS_DASHBOARD_TOKEN=change-me-to-a-long-random-string

# --- LLM (mock | ollama | openai | gemini). 'mock' = grounded heuristic, no key. ---
# For real SME reasoning, pick one:
#   Local (free): install Ollama, `ollama pull llama3.1`, then set:
#     ATS_LLM_PROVIDER=ollama   ATS_LLM_MODEL=llama3.1   ATS_LLM_BASE_URL=http://localhost:11434
#   Google Gemini (AI Studio key): set
#     ATS_LLM_PROVIDER=gemini   ATS_LLM_MODEL=gemini-2.5-flash
#     ATS_LLM_BASE_URL=https://generativelanguage.googleapis.com   ATS_LLM_API_KEY=...
#   Hosted (paid): set ATS_LLM_PROVIDER=openai, ATS_LLM_MODEL=gpt-4o-mini, ATS_LLM_API_KEY=...
# The CIO can use a stronger model for synthesis via ATS_LLM_CIO_MODEL.
# NOTE: at startup the agent service probes the endpoint; if a real provider is
# configured but unreachable it logs llm_selfcheck_failed and downgrades to the
# mock for that session (so you never pay a 60s timeout per SME call).
ATS_LLM_PROVIDER=ollama
ATS_LLM_MODEL=llama3.1
ATS_LLM_BASE_URL=http://localhost:11434
# ATS_LLM_CIO_MODEL=llama3.1
# ATS_LLM_API_KEY=
# ATS_LLM_TIMEOUT_S=60

# --- External data APIs (free-tier v1 stack; optional) ---
# ATS_MARKETAUX_API_KEY=
# ATS_ALPHAVANTAGE_API_KEY=
# ATS_FMP_API_KEY=
# ATS_FRED_API_KEY=
# ATS_TELEGRAM_BOT_TOKEN=
# ATS_TELEGRAM_CHAT_ID=

# --- Zerodha Kite (deferred until real money) ---
# ATS_KITE_API_KEY=
# ATS_KITE_API_SECRET=
# ATS_KITE_ACCESS_TOKEN=
