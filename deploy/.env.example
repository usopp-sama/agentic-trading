# Copy to repo-root .env and fill in. NEVER commit real secrets.
# All keys are optional for v1 (paper, offline). Fill them as you enable features.

# --- Core ---
ATS_ENV=dev
ATS_DEBUG=true

# --- Storage (SQLite default; Postgres/TimescaleDB for production) ---
# ATS_DB_URL=postgresql+psycopg://ats:ats@postgres:5432/ats
ATS_DB_URL=sqlite:///var/ats.db

# --- Event bus (memory default; redis for multi-service) ---
ATS_EVENT_BUS=memory
# ATS_REDIS_URL=redis://redis:6379/0

# --- Market data (yfinance | synthetic | kite) ---
# yfinance = real (delayed) NSE data; falls back to synthetic per-symbol only
# if a live fetch fails. Use 'synthetic' to force fully-offline operation.
ATS_DATA_SOURCE=yfinance

# --- Trading mode + real-money gate ---
# mode: OFF | PAPER | APPROVAL | AUTO. Keep PAPER for v1.
ATS_TRADING_MODE=PAPER
# Master safety gate. Leave false until paper/shadow + compliance pass.
ATS_REAL_MONEY_ENABLED=false
ATS_PAPER_STARTING_CAPITAL=1000000

# --- LLM (mock | ollama | openai). 'mock' = grounded heuristic, no key. ---
# For real SME reasoning, either:
#   Local (free): install Ollama, `ollama pull llama3.1`, then set:
#     ATS_LLM_PROVIDER=ollama   ATS_LLM_MODEL=llama3.1   ATS_LLM_BASE_URL=http://localhost:11434
#   Hosted (paid): set ATS_LLM_PROVIDER=openai, ATS_LLM_MODEL=gpt-4o-mini, ATS_LLM_API_KEY=...
# The CIO can use a stronger model for synthesis via ATS_LLM_CIO_MODEL.
ATS_LLM_PROVIDER=mock
ATS_LLM_MODEL=mock-1
# ATS_LLM_BASE_URL=http://localhost:11434
# ATS_LLM_CIO_MODEL=
# ATS_LLM_API_KEY=

# --- External data APIs (free-tier v1 stack; optional) ---
# ATS_MARKETAUX_API_KEY=
# ATS_ALPHAVANTAGE_API_KEY=
# ATS_FMP_API_KEY=
# ATS_FRED_API_KEY=
# ATS_TELEGRAM_BOT_TOKEN=
# ATS_TELEGRAM_CHAT_ID=

# --- Zerodha Kite (deferred until real money) ---
# ATS_KITE_API_KEY=
# ATS_KITE_API_SECRET=
# ATS_KITE_ACCESS_TOKEN=
